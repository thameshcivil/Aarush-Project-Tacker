<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ replacement for backup_rules.xml — same intent: make sure Android's own cloud
     backup and device-to-device transfer both include the "databases" folder. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
